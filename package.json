{
  "name": "pokeathlon",
  "private": true,
  "version": "0.1.0",
  "description": "Non-commercial 3v3 Pok\u00e9mon strike-ball fan game",
  "type": "module",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pokeathlon/client",
    "dev:lan": "npm run dev -w @pokeathlon/client -- --host",
    "build": "npm run build -w @pokeathlon/client",
    "preview": "npm run preview -w @pokeathlon/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "import-sprites": "tsx tools/import-sprites.ts",
    "record": "tsx tools/record-match.ts",
    "sim": "tsx tools/sim-batch.ts",
    "ladder": "tsx tools/sim-batch.ts --ladder",
    "balance": "tsx tools/balance.ts",
    "playstyle": "tsx tools/playstyle.ts",
    "kits": "tsx tools/kits.ts",
    "determinism": "tsx tools/determinism.ts",
    "server": "tsx packages/server/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-xml-parser": "^5.12.0",
    "globals": "^17.14.0",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
